# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-secret-key

# Recall.ai API (eu-central-1 dashboard → API Keys)
