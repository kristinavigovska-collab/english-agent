# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-secret-key

# Optional: apply migrations via scripts/run_supabase_migration.py
# SUPABASE_ACCESS_TOKEN=sbp_...
# DATABASE_URL=postgresql://...

# Recall.ai API (eu-central-1 dashboard → API Keys)
RECALL_API_KEY=your-recall-api-key
RECALL_REGION=eu-central-1

# Optional: secret to verify Recall.ai webhook signatures
RECALL_WEBHOOK_SECRET=your-recall-webhook-secret

# Website speaking drill (public endpoint POST /api/drill/analyze)
DEEPGRAM_API_KEY=
# Optional: DEEPGRAM_MODEL=nova-3
# Optional: DRILL_CLAUDE_MODEL=claude-sonnet-5-5
# Comma-separated website origins allowed by CORS, e.g. https://aimon.com,https://www.aimon.com
DRILL_CORS_ORIGINS=
# Optional: free reviews per IP per day (default 3); DRILL_DISABLE_LIMIT=1 turns the limit off for local dev
# DRILL_DAILY_LIMIT=3
